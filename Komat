-- picks a theme from the current month (Oct / Dec / Feb / Jun-Aug)
function KRYVEX:AutoTheme()

    local ok, month = pcall(function()
        return tonumber(os.date("%m"))
    end)

    if not ok or not month then
        return "Normal"
    end

    if month == 10 then
        return "Halloween"
    elseif month == 12 then
        return "Christmas"
    elseif month == 2 then
        return "Valentine"
    elseif month >= 6 and month <= 8 then
        return "Summer"
    end

    return "Normal"

end

-- returns the canonical theme name, or nil if unknown
function KRYVEX:ResolveTheme(name)

    if type(name) ~= "string" then
        return nil
    end

    if KRYVEX.Themes[name] then
        return name
    end

    local key = string.lower(name)
    key = string.gsub(key, "^%s+", "")
    key = string.gsub(key, "%s+$", "")

    if key == "auto" then
        return KRYVEX:AutoTheme()
    end

    if KRYVEX.ThemeAliases[key] then
        return KRYVEX.ThemeAliases[key]
    end

    for themeName, data in pairs(KRYVEX.Themes) do
        if data.Display == name then
            return themeName
        end
    end

    return nil

end

-- Thai display names, in order (handy for dropdowns)
function KRYVEX:GetThemeNames()

    local list = {}

    for _, themeName in ipairs(KRYVEX.ThemeOrder) do
        table.insert(list, KRYVEX.Themes[themeName].Display)
    end

    return list

end

-- switch theme (recolors every open window live)
function KRYVEX:SetTheme(name)

    local resolved = KRYVEX:ResolveTheme(name)

    if not resolved then
        warn("[KRYVEX] unknown theme: " .. tostring(name))
        return false
    end

    local Data = KRYVEX.Themes[resolved]

    local Old = {}

    for key, color in pairs(KRYVEX.Theme) do
        Old[key] = color
    end

    -- mutate in place so every later tween reads the new colors
    for key, color in pairs(Data.Colors) do
        KRYVEX.Theme[key] = color
    end

    KRYVEX.CurrentTheme = resolved
    KRYVEX.ThemeData = Data

    for index = #KRYVEX.Windows, 1, -1 do

        local Win = KRYVEX.Windows[index]

        if Win.Destroyed then
            table.remove(KRYVEX.Windows, index)
        elseif Win._ApplyTheme then

            local ok, err = pcall(Win._ApplyTheme, Old, Data)

            if not ok then
                warn("[KRYVEX] theme apply failed: " .. tostring(err))
            end

        end

    end

    return true

end

-- ember color for the Fire effect, taken from the active theme
local function ThemeEmberColor()

    local Data = KRYVEX.ThemeData
    local Palette = Data and Data.Embers

    if not Palette or #Palette == 0 then
        return Color3.fromRGB(255, 140, 50)
    end

    local roll = math.random(1, 10)
    local index = 1

    if roll > 8 then
        index = math.min(3, #Palette)
    elseif roll > 6 then
        index = math.min(2, #Palette)
    end

    return Palette[index]:Lerp(
        Color3.new(1, 1, 1),
        math.random(0, 20) / 100
    )

end

