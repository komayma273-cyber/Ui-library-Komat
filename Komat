    --=====================================================
    -- THEME (LIVE SWITCH)
    --=====================================================

    local function ThemeSequence(Colors, Positions)

        local Keypoints = {}

        for index, color in ipairs(Colors) do
            table.insert(
                Keypoints,
                ColorSequenceKeypoint.new(Positions[index], color)
            )
        end

        return ColorSequence.new(Keypoints)

    end

    local function ColorKey(color)

        return string.format(
            "%d,%d,%d",
            math.floor(color.R * 255 + 0.5),
            math.floor(color.G * 255 + 0.5),
            math.floor(color.B * 255 + 0.5)
        )

    end

    -- gradients (not the stroke color) carry the border look:
    -- UIGradient multiplies with the stroke color, so the stroke stays white
    local function ApplyDecor(Data)

        MainSheen.Color = ThemeSequence(Data.Sheen, { 0, 0.45, 1 })

        MainStroke.Color = Color3.new(1, 1, 1)
        BorderGradient.Color = ThemeSequence(Data.Border, { 0, 0.5, 1 })

        FloatStroke.Color = Color3.new(1, 1, 1)
        FloatGradient.Color = ThemeSequence(Data.Float, { 0, 0.5, 1 })
        FloatButton.BackgroundColor3 = Data.FloatBg

    end

    -- called by KRYVEX:SetTheme with the previous palette and the new theme
    Window._ApplyTheme = function(Old, Data)

        local Map = {}

        for key, oldColor in pairs(Old) do
            if Data.Colors[key] then
                Map[ColorKey(oldColor)] = Data.Colors[key]
            end
        end

        local function Swap(color)
            return Map[ColorKey(color)]
        end

        local function Walk(root)

            if not root then
                return
            end

            for _, inst in ipairs(root:GetDescendants()) do

                if inst:IsA("GuiObject") then
                    local new = Swap(inst.BackgroundColor3)
                    if new then
                        inst.BackgroundColor3 = new
                    end
                end

                if inst:IsA("TextLabel")
                    or inst:IsA("TextButton")
                    or inst:IsA("TextBox")
                then
                    local new = Swap(inst.TextColor3)
                    if new then
                        inst.TextColor3 = new
                    end
                end

                if inst:IsA("TextBox") then
                    local new = Swap(inst.PlaceholderColor3)
                    if new then
                        inst.PlaceholderColor3 = new
                    end
                end

                if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
                    local new = Swap(inst.ImageColor3)
                    if new then
                        inst.ImageColor3 = new
                    end
                end

                if inst:IsA("ScrollingFrame") then
                    local new = Swap(inst.ScrollBarImageColor3)
                    if new then
                        inst.ScrollBarImageColor3 = new
                    end
                end

                if inst:IsA("UIStroke") then
                    local new = Swap(inst.Color)
                    if new then
                        inst.Color = new
                    end
                end

                if inst:IsA("UIGradient") then

                    local changed = false
                    local points = {}

                    for _, keypoint in ipairs(inst.Color.Keypoints) do

                        local new = Swap(keypoint.Value)

                        if new then
                            changed = true
                        end

                        table.insert(
                            points,
                            ColorSequenceKeypoint.new(
                                keypoint.Time,
                                new or keypoint.Value
                            )
                        )

                    end

                    if changed then
                        inst.Color = ColorSequence.new(points)
                    end

                end

            end

        end

        Walk(Window.ScreenGui)
        Walk(Window.FloatGui)

        ApplyDecor(Data)

        if Window.UseBorderIcons then
            KRYVEX.Effects:BorderIcons(Main)
        end

    end

    function Window:SetTheme(name)
        return KRYVEX:SetTheme(name)
    end

    function Window:GetTheme()
        return KRYVEX.CurrentTheme
    end

    ApplyDecor(KRYVEX.ThemeData)

    table.insert(KRYVEX.Windows, Window)

    --=====================================================
