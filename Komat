--=========================================================

function KRYVEX.Effects:Spooky(Container)

    if not Container then
        return
    end

    local Holder = Container:FindFirstChild("KRYVEX_Spooky")

    if Holder then
        return Holder
    end

    Holder = Create("Frame", {
        Name = "KRYVEX_Spooky",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
        ZIndex = 4,
    })

    Holder.Parent = Container

    task.spawn(function()

        while Holder.Parent do

            task.wait(math.random(18, 40) / 10)

            if not Holder.Parent then
                break
            end

            local Data = KRYVEX.ThemeData
            local Floaters = Data and Data.Floaters

            -- Normal theme has no floaters, so the loop just idles
            if Floaters and #Floaters > 0 then

                local StartX = math.random(5, 95) / 100

                local Icon = Create("TextLabel", {
                    Size = UDim2.fromOffset(28, 28),
                    Position = UDim2.new(StartX, 0, 1.05, 0),
                    BackgroundTransparency = 1,
                    Text = Floaters[math.random(#Floaters)],
                    TextSize = math.random(16, 26),
                    TextTransparency = 0.35,
                    Rotation = math.random(-25, 25),
                    ZIndex = 4,
                })

                Icon.Parent = Holder

                local Drift = PlayTween(
                    Icon,
                    math.random(50, 90) / 10,
                    {
                        Position = UDim2.new(
                            StartX + math.random(-10, 10) / 100,
                            0,
                            -0.1,
                            0
                        ),
                        TextTransparency = 1,
                        Rotation = math.random(-40, 40),
                    },
                    Enum.EasingStyle.Sine,
                    Enum.EasingDirection.InOut
                )

                Drift.Completed:Connect(function()
                    Icon:Destroy()
                end)

            end

        end

    end)

    return Holder

end

-- rebuilds every time it is called, so a theme switch just calls it again
function KRYVEX.Effects:BorderIcons(Container)

    if not Container then
        return
    end

    local Existing = Container:FindFirstChild("KRYVEX_BorderIcons")

    if Existing then
        Existing:Destroy()
    end

    local Data = KRYVEX.ThemeData
    local Garland = Data and Data.Garland

    if not Garland or #Garland == 0 then
        return
    end

    local Holder = Create("Frame", {
        Name = "KRYVEX_BorderIcons",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Active = false,
        ZIndex = 10,
    })

    Holder.Parent = Container

    local function AddIcon(text, size, anchor, position, bob, sway)

        local Icon = Create("TextLabel", {
            Size = UDim2.fromOffset(size + 4, size + 4),
            AnchorPoint = anchor,
            Position = position,
            BackgroundTransparency = 1,
            Active = false,
            Text = text,
            TextSize = size,
            TextTransparency = 0.1,
            ZIndex = 10,
        })

        Icon.Parent = Holder

        -- gentle bob + sway so the garland feels alive
        local BobTween = TweenService:Create(
            Icon,
            TweenInfo.new(
                math.random(15, 28) / 10,
                Enum.EasingStyle.Sine,
                Enum.EasingDirection.InOut,
                -1,
                true
            ),
            {
                Position = UDim2.new(
                    position.X.Scale,
                    position.X.Offset,
                    position.Y.Scale,
                    position.Y.Offset + bob
                ),
                Rotation = sway,
            }
        )

        task.delay(math.random(0, 12) / 10, function()
            if Icon.Parent then
                BobTween:Play()
            end
        end)

        return Icon

    end

    local Count = #Garland

    for i = 1, Count do

        local x = (i - 0.5) / Count

        -- top edge (stays clear of logo + minimize / close)
        AddIcon(
            Garland[i],
            12,
            Vector2.new(0.5, 0),
            UDim2.new(x, 0, 0, 0),
            2,
            math.random(4, 10)
        )

        -- bottom edge (reversed order so it is not a mirror image)
        AddIcon(
            Garland[Count - i + 1],
            12,
            Vector2.new(0.5, 1),
            UDim2.new(x, 0, 1, 0),
            -2,
            -math.random(4, 10)
        )

    end

    if Data.Corner then

        AddIcon(Data.Corner, 18, Vector2.new(0, 0), UDim2.new(0, 1, 0, 0), 1, 4)
        AddIcon(Data.Corner, 18, Vector2.new(1, 0), UDim2.new(1, -1, 0, 0), 1, -4)
        AddIcon(Data.Corner, 18, Vector2.new(0, 1), UDim2.new(0, 1, 1, 0), -1, -4)
        AddIcon(Data.Corner, 18, Vector2.new(1, 1), UDim2.new(1, -1, 1, 0), -1, 4)

    end

    return Holder

end

