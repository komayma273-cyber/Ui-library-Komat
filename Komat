function KRYVEX.Effects:Glow(
    Object,
    Color
)

    if not Object
        or not Object.Parent
    then
        return
    end

    Color =
        Color
        or KRYVEX.Theme.Primary

    local Stroke =
        Object:FindFirstChild(
            "KRYVEX_Glow"
        )

    if not Stroke then

        Stroke =
            Instance.new(
                "UIStroke"
            )

        Stroke.Name =
            "KRYVEX_Glow"

        Stroke.Thickness =
            1

        Stroke.Transparency =
            0.8

        Stroke.Color =
            Color

        Stroke.Parent =
            Object

    end

    PlayTween(
        Stroke,
        0.25,
        {
            Transparency = 0.12,
            Thickness = 2
        }
    )

    return Stroke

end

--=========================================================
-- PULSE
--=========================================================

function KRYVEX.Effects:Pulse(
    Object
)

    if not Object then
        return
    end

    local Scale =
        Object:FindFirstChild(
            "KRYVEX_PulseScale"
        )

    if not Scale then

        Scale =
            Instance.new(
                "UIScale"
            )

        Scale.Name =
            "KRYVEX_PulseScale"

        Scale.Scale =
            1

        Scale.Parent =
            Object

    end

    task.spawn(function()

        while Object.Parent do

            local Tween1 =
                PlayTween(
                    Scale,
                    0.7,
                    {
                        Scale = 1.025
                    },
                    Enum.EasingStyle.Sine,
                    Enum.EasingDirection.InOut
                )

            Tween1.Completed:Wait()

            if not Object.Parent then
                break
            end

            local Tween2 =
                PlayTween(
                    Scale,
                    0.7,
                    {
                        Scale = 1
                    },
                    Enum.EasingStyle.Sine,
                    Enum.EasingDirection.InOut
                )

            Tween2.Completed:Wait()

        end

    end)

end

--=========================================================
-- SHAKE
--=========================================================

function KRYVEX.Effects:Shake(
    Object,
    Strength
)

    if not Object then
        return
    end

    Strength =
        Strength
        or 4

    local Original =
        Object.Position

    task.spawn(function()

        for i = 1, 8 do

            if not Object.Parent then
                return
            end

            local X =
                math.random(
                    -Strength,
                    Strength
                )

            local Y =
                math.random(
                    -Strength,
                    Strength
                )

            Object.Position =
                UDim2.new(

                    Original.X.Scale,
                    Original.X.Offset + X,

                    Original.Y.Scale,
                    Original.Y.Offset + Y

                )

            task.wait(
                0.035
            )

        end

        if Object.Parent then

            Object.Position =
                Original

        end

    end)

end

