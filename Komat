                        TextXAlignment =
                            Enum.TextXAlignment.Left,

                        AutoButtonColor =
                            false,

                    }
                )

            Button.Parent =
                Frame

            local OptionButtons =
                {}

            local function Refresh()

                Button.Text =
                    tostring(
                        selected
                    )
                    ..
                    "  "
                    ..
                    (
                        open
                        and "\u{25B2}"
                        or "\u{25BC}"
                    )

            end

            for index, option in ipairs(
                options
            ) do

                local Option =
                    Create(
                        "TextButton",
                        {

                            Name =
                                "Option_"
                                .. index,

                            Size =
                                UDim2.new(
                                    1,
                                    -20,
                                    0,
                                    30
                                ),

                            Position =
                                UDim2.fromOffset(
