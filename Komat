                Enum.UserInputType.Touch
            then

                local delta =
                    input.Position
                    - floatDragStart

                if math.abs(delta.X) > 5
                    or
                    math.abs(delta.Y) > 5
                then

                    floatMoved =
                        true

                end

                FloatButton.Position =
                    UDim2.new(

                        floatStartPosition.X.Scale,

                        floatStartPosition.X.Offset
                        + delta.X,

                        floatStartPosition.Y.Scale,

                        floatStartPosition.Y.Offset
                        + delta.Y

