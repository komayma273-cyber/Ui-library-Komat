function KRYVEX.Effects:Rainbow(
    Object
)

    if not Object then
        return
    end

    local Gradient =
        Object:FindFirstChild(
            "KRYVEX_Rainbow"
        )

    if not Gradient then

        Gradient =
            Instance.new(
                "UIGradient"
            )

        Gradient.Name =
            "KRYVEX_Rainbow"

        Gradient.Color =
            ColorSequence.new({

                ColorSequenceKeypoint.new(
                    0,
                    Color3.fromRGB(
                        255,
                        70,
                        70
                    )
                ),

                ColorSequenceKeypoint.new(
                    0.2,
                    Color3.fromRGB(
                        255,
                        210,
                        70
                    )
                ),

                ColorSequenceKeypoint.new(
                    0.4,
                    Color3.fromRGB(
                        80,
                        255,
                        120
                    )
                ),

                ColorSequenceKeypoint.new(
                    0.6,
                    Color3.fromRGB(
                        80,
                        180,
                        255
                    )
                ),

                ColorSequenceKeypoint.new(
                    0.8,
                    Color3.fromRGB(
                        170,
                        90,
                        255
                    )
                ),

                ColorSequenceKeypoint.new(
                    1,
                    Color3.fromRGB(
                        255,
                        80,
                        180
                    )
                ),

            })

        Gradient.Parent =
            Object

    end

    task.spawn(function()

        while Object.Parent do

            Gradient.Rotation =
                (
                    Gradient.Rotation
                    + 2
                )
                % 360

            task.wait(
                0.03
            )

        end

    end)

    return Gradient

end

