                        PlayTween(
                            Frame,
                            0.2,
                            {

                                Size =
                                    UDim2.new(
                                        1,
                                        0,
                                        0,
                                        48
                                    )

                            }
                        )

                        Refresh()

                        if config.Callback then

                            task.spawn(
                                config.Callback,
                                selected
                            )

                        end

                    end
                )

            end

            Button.Activated:Connect(
                function()

                    open =
                        not open

                    for _, item in ipairs(
                        OptionButtons
                    ) do

                        item.Visible =
                            open

                    end

                    local height =
                        open
                        and (
                            48
                            +
                            #options
                            * 34
                        )
                        or 48

                    PlayTween(
                        Frame,
                        0.2,
                        {

                            Size =
                                UDim2.new(
                                    1,
                                    0,
                                    0,
                                    height
                                )

                        }
                    )

                    Refresh()

                end
            )

            return {

                Set = function(
                    _,
                    value
                )

                    selected =
                        value

                    Refresh()

                end,

                Get = function()

                    return selected

                end

            }

        end

