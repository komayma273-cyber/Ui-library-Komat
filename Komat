            local function Search(
                Query
            )

                Query =
                    string.lower(
                        Query or ""
                    )

                for _, Child in ipairs(
                    Page:GetChildren()
                ) do

                    if Child ~= Frame
                        and Child:IsA("GuiObject")
                        and not Child:IsA(
                            "UIListLayout"
                        )
                        and not Child:IsA(
                            "UIPadding"
                        )
                    then

                        if Query == "" then

                            Child.Visible =
                                true

                        else

                            local Name =
                                string.lower(
                                    Child.Name
                                    or ""
                                )

                            local Text =
                                ""

                            pcall(function()

                                Text =
                                    string.lower(
                                        Child.Text
                                        or ""
                                    )

                            end)

                            Child.Visible =
                                string.find(
                                    Name,
                                    Query,
                                    1,
                                    true
                                )
                                ~= nil
                                or
                                string.find(
                                    Text,
                                    Query,
                                    1,
                                    true
                                )
                                ~= nil

                        end

                    end

                end

            end

            Input:GetPropertyChangedSignal(
                "Text"
            ):Connect(
                function()

                    Search(
                        Input.Text
                    )

                    if config.Callback then

                        task.spawn(
                            config.Callback,
                            Input.Text
                        )

                    end

                end
            )

            return Input

        end

