                            Position =
                                UDim2.fromOffset(
                                    10,
                                    48
                                    +
                                    (
                                        index - 1
                                    )
                                    * 34
                                ),

                            BackgroundColor3 =
                                KRYVEX.Theme.Background,

                            Text =
                                tostring(
                                    option
                                ),

                            TextColor3 =
                                KRYVEX.Theme.SubText,

                            TextSize =
                                11,

                            Font =
                                Enum.Font.Gotham,

                            AutoButtonColor =
