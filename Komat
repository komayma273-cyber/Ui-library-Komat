                GetGameName()

            local function UpdateInfo()

                InfoLabel.Text =
                    "\u{1F4E6} KRYVEX v"
                    .. KRYVEX.Version
                    .. "\n"
                    .. "\u{1F194} User ID: "
                    .. tostring(
                        LocalPlayer.UserId
                    )
                    .. "    \u{1F3AE} "
                    .. tostring(
                        GameName
                    )
                    .. "\n"
                    .. "\u{1F194} Place: "
                    .. tostring(
                        game.PlaceId
                    )
                    .. "    \u{1F5A5}\u{FE0F} Job: "
                    .. tostring(
                        string.sub(
                            game.JobId,
                            1,
                            18
                        )
                    )
                    .. "..."

            end

            UpdateInfo()

            --=================================================
            -- FPS TRACKER
            --=================================================

            local Frames =
                0

            local FPS =
                0

            local LastTime =
                os.clock()

            local FPSConnection

            FPSConnection =
                RunService.RenderStepped:Connect(
                    function()

                        if not Card.Parent then

                            if FPSConnection then
                                FPSConnection:Disconnect()
                            end

                            return

                        end

                        Frames += 1

                        local Now =
                            os.clock()

                        if Now - LastTime >= 1 then

                            FPS =
                                Frames

                            Frames =
                                0

                            LastTime =
                                Now

                            local Ping =
                                GetPing()

                            Performance.Text =
                                "\u{1F4F6} FPS: "
                                .. tostring(
                                    FPS
                                )
                                .. "   \u{2022}   Ping: "
                                .. tostring(
                                    Ping
                                )
                                .. " ms"

                        end

                    end
                )

            --=================================================
            -- LIVE DOT
            --=================================================

            task.spawn(function()

                while Card.Parent do

                    PlayTween(
                        LiveDot,
                        0.6,
                        {

                            BackgroundTransparency =
                                0.7

                        }
                    ).Completed:Wait()

                    PlayTween(
                        LiveDot,
                        0.6,
                        {

                            BackgroundTransparency =
                                0

                        }
                    ).Completed:Wait()

                end

            end)

            --=================================================
            -- FIRE
            --=================================================

            if config.Fire ~= false then

                KRYVEX.Effects:Fire(
                    Card
                )

            end

            --=================================================
            -- GLOW
            --=================================================

            if config.Glow ~= false then

                KRYVEX.Effects:Glow(
                    Card
                )

            end

            return {

                Frame =
                    Card,

                Avatar =
                    BigAvatar,

                Name =
                    NameLabel,

                Info =
                    InfoLabel,

                Performance =
                    Performance,

                Update =
                    UpdateInfo

            }

        end

