local function ResolveBackground()

    local cfg = KRYVEX.Background

    if not cfg.Enabled then
        return nil
    end

    if cfg.Image and cfg.Image ~= "" then
        return cfg.Image
    end

    local getAsset =
        getcustomasset
        or getsynasset

    if not (getAsset and isfile and writefile) then
        return nil
    end

    pcall(function()

        if cfg.Url ~= ""
            and not isfile(cfg.File)
        then
            writefile(
                cfg.File,
                game:HttpGet(cfg.Url)
            )
        end

    end)

    local ok, asset = pcall(function()

        if isfile(cfg.File) then
            return getAsset(cfg.File)
        end

    end)

    if ok and asset then
        return asset
    end

    return nil

end

