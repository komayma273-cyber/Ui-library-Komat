                        }
                    )

                Option.Parent =
                    Frame

                AddCorner(
                    Option,
                    KRYVEX.Corners.Inner
                )

                OptionButtons[index] =
                    Option

                Option.Activated:Connect(
                    function()

                        selected[option] =
                            not selected[option]

                        Option.Text =
                            selected[option]

                            and (
                                "\u{2713} "
                                ..
                                tostring(
                                    option
                                )
                            )

                            or tostring(
                                option
                            )

                        Refresh()

                        if config.Callback then

                            local result =
                                {}

                            for value, state in pairs(
                                selected
                            ) do

                                if state then

                                    table.insert(
                                        result,
                                        value
                                    )

                                end

                            end

                            task.spawn(
                                config.Callback,
                                result
                            )

                        end

                    end
                )

            end

            Button.Activated:Connect(
                function()

                    open =
                        not open

                    for _, item in ipairs(
                        OptionButtons
                    ) do

                        item.Visible =
                            open

                    end

                    local height =
                        open
                        and (
                            48
                            +
                            #options
                            * 34
                        )
                        or 48

                    PlayTween(
                        Frame,
                        0.2,
                        {

                            Size =
                                UDim2.new(
                                    1,
                                    0,
                                    0,
                                    height
                                )

                        }
                    )

                    Refresh()

                end
            )

            Refresh()

            return {

                Get = function()

                    local result =
                        {}

                    for value, state in pairs(
                        selected
                    ) do

                        if state then

                            table.insert(
                                result,
                                value
                            )

                        end

                    end

                    return result

                end

            }

        end

